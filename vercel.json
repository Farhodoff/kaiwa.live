{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/api/telegram/(.*)", "destination": "/api/telegram.js" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/version.json", "destination": "/version.json" },
    { "source": "/workbox-(.*).js", "destination": "/workbox-$1.js" },
    {
      "source": "/((?!api/|assets/|sw\\.js|workbox-|version\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/telegram/notify-daily",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/telegram/dispatch-daily-dataset",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/telegram/dispatch-group-battle",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://telegram.org;"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self)"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|logo\\.png|apple-touch-icon\\.png|manifest\\.json|robots\\.txt|sitemap\\.xml|llms\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(version\\.json|sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/((?!assets/|favicon\\.svg|logo\\.png|manifest\\.json|robots\\.txt|sitemap\\.xml|llms\\.txt).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
