# Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# TASK PLANNER

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Telegram Bot Configuration (Server-Only Secret)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VITE_TELEGRAM_DATASET_CHAT_ID=your_telegram_dataset_chat_id

# Service Role Key (for backend)
SERVICE_ROLE=your_supabase_service_role_key

# Azure AI Speech (server-only secrets)
# Resource: kaiwa-speech-live, region: swedencentral
# Keep the key only in Vercel/Supabase/server environment variables.
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=swedencentral
# Optional custom endpoint; leave empty to derive it from AZURE_SPEECH_REGION.
AZURE_SPEECH_ENDPOINT=

# Ollama Configuration (Local AI - Optional)
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=gpt-oss:120b-cloud

# Optional production TURN credentials for Study Room WebRTC.
# Do not use the public OpenRelay defaults in production.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# AI API Keys (BYOK - Bring Your Own Key)
# Gemini va DeepSeek API kalitlari .env ga qo'yilMAYDI!
# Foydalanuvchilar kalitlarini Sozlamalar → AI bo'limida kiritadilar.
# Bu kalitlar faqat brauzerning localStorage'ida saqlanadi.
